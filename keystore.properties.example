# V4SH Keystore Configuration Example
# Copy this file to 'keystore.properties' and fill in your secure release credentials.
# DO NOT commit 'keystore.properties' or your .jks/.keystore file to Git!

storeFile=C:/Users/username/keys/v4sh-release.jks
storePassword=YourKeystorePassword
keyAlias=v4sh-key-alias
keyPassword=YourKeyPassword
